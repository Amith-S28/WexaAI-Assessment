# Local Capped Docker Benchmarking Environment Secrets
# Points to localhost ports mapped in docker-compose.benchmark.yml

# 1. CognoDB (Points to Managed Cloud Instance as baseline)
COGNODB_URI=
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# 2. Neo4j 5 Community Local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmarkpassword

# 3. Memgraph Local
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# 4. FalkorDB Local
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=

# 5. ArangoDB Local
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=benchmarkpassword

# 6. KuzuDB Local
KUZU_ENDPOINT=http://localhost:8000

# 7. ArcadeDB Local
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=benchmarkpassword
ARCADEDB_DATABASE=benchmark

# 8. JanusGraph Local
JANUSGRAPH_ENDPOINT=http://localhost:8182
