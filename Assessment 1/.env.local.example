# Local Capped Docker Benchmarking Environment Secrets
# Points to localhost ports mapped in docker-compose.benchmark.yml

# 1. CognoDB Local (ghcr.io/cognodb/cognodb:latest)
COGNODB_URI=bolt://localhost:7689
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# 2. Neo4j 5 Community Local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmarkpassword

# 3. Memgraph Local
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# 4. FalkorDB Local
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=

# 5. ArangoDB Local
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=benchmarkpassword
