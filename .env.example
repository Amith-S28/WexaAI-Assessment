# ====================================================================
# GRAPH DATABASE CLOUD BENCHMARK - ENVIRONMENT TEMPLATE
# ====================================================================
# Copy this file to .env and fill in your credentials

# 1. CognoDB Cloud
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# 2. Neo4j AuraDB Free
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 3. Memgraph Cloud / Local
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# 4. FalkorDB Cloud / Local
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# 5. ArangoDB Cloud / Local
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=
